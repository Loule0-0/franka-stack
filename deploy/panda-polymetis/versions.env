# Historical Panda/FER stack only. This is not a modern FR3 configuration.
# These pins reproduce the frozen fairo source baseline. The version gate below
# selects an officially matrix-compatible historical Robot System combination;
# it has not been observed or certified on the user's physical robot. Validate
# firmware, FCI, realtime behavior, and protective stops before enabling motion.
PANDA_STACK_STATUS=legacy_historical_not_hardware_revalidated
FAIRO_REPOSITORY=https://github.com/facebookresearch/fairo.git
FAIRO_COMMIT=0a01a7fa7a7c65b2f9a3aebf5e79040940daf9d2
LIBFRANKA_COMMIT=c452ba20397cde846fe2e48d0be94b522ef88dac
LIBFRANKA_VERSION=0.9.0
POLYMETIS_PYTHON_VERSION=3.8
EXPECTED_ROBOT_SYSTEM_VERSION=4.0.0
EXPECTED_ROBOT_SERVER_VERSION=4
EXPECTED_GRIPPER_SERVER_VERSION=3
