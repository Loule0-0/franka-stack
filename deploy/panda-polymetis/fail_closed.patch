+def test_stop_replaces_cached_goto_command():
+    server = PolymetisGripperServer()
+    goto = polymetis_pb2.GripperCommand(width=0.04, speed=0.05, force=10.0)
+    goto.timestamp.seconds = 100
+    server.Goto(goto, None)
+
+    # Stop is accepted even if the trusted client's clock moved backwards.
+    # The server normalizes the cached Stop just beyond the prior command,
+    # without mixing in its own wall clock.
+    stop = polymetis_pb2.GripperCommand(stop=True)
+    stop.timestamp.seconds = 99
+    server.Stop(stop, None)
+    command = server.ControlUpdate(polymetis_pb2.GripperState(), None)
+
+    assert command.stop
+    assert command.timestamp.seconds == 100
+    assert command.timestamp.nanos == 1
+
+    # A Goto already timestamped before Stop cannot overwrite the stop cache
+    # if its RPC arrives late.
+    server.Goto(goto, None)
+    assert server.ControlUpdate(polymetis_pb2.GripperState(), None).stop
+
+    # A genuinely later command remains usable (for example after a new user
+    # process explicitly starts a new session).
+    later = polymetis_pb2.GripperCommand(width=0.06, speed=0.05, force=10.0)
+    later.timestamp.seconds = command.timestamp.seconds + 1
+    server.Goto(later, None)
+    current = server.ControlUpdate(polymetis_pb2.GripperState(), None)
+    assert not current.stop
+    assert current.width == pytest.approx(0.06)
