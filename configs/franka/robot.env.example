# Copy to a file outside Git, fill every REQUIRED value, then load it with:
# set -a; source /absolute/path/to/robot.env; set +a
FRANKA_PROJECT_ROOT=/absolute/path/to/franka-stack
PANDA_POLYMETIS_SOURCE_ROOT=/absolute/path/to/fairo
PANDA_POLYMETIS_ENV_PREFIX=/absolute/path/to/pinned-polymetis-prefix
GELLO_INSTALL_ROOT=/absolute/path/to/gello_software

ROBOT_MODEL=franka_panda
ROBOT_FCI_IP=172.16.0.2
FRANKA_ROBOT_NIC=REQUIRED_INTERFACE_NAME
ROBOT_PC_FCI_CIDR=172.16.0.1/24

POLYMETIS_HOST=127.0.0.1
POLYMETIS_ARM_PORT=50051
POLYMETIS_GRIPPER_PORT=50052
GELLO_ROBOT_PORT=6001

GELLO_PORT=/dev/serial/by-id/REQUIRED_GELLO_DEVICE
GELLO_CALIBRATION=/absolute/path/to/gello_calibration.json
DEADMAN_DEVICE=/dev/input/by-id/REQUIRED_DEADMAN_DEVICE
EXTERIOR_CAMERA_SERIAL=REQUIRED_REALSENSE_SERIAL
WRIST_CAMERA_SERIAL=REQUIRED_REALSENSE_SERIAL
EXTERIOR_CAMERA_PORT=5000
WRIST_CAMERA_PORT=5001

# Use an SSH tunnel to the GPU host; do not expose port 8000 on the public Internet.
POLICY_HOST=127.0.0.1
POLICY_PORT=8000
POLICY_PROMPT="pick up the object"
