# Persistent GPU-server layout. Adjust the account root if this repository is used elsewhere.
# Load this file with: set -a; source /absolute/path/to/server.env; set +a
FRANKA_PROJECT_ROOT=/home/data/zeyu.lou/project/franka-stack
OPENPI_ROOT=/home/data/zeyu.lou/project/franka-stack/third_party/openpi
HF_LEROBOT_HOME=/home/data/zeyu.lou/datasets/franka-stack
OPENPI_DATA_HOME=/home/data/zeyu.lou/models/openpi-assets
FRANKA_CHECKPOINT_ROOT=/home/data/zeyu.lou/checkpoints/franka-stack
FRANKA_TRAIN_STATE_ROOT=/home/data/zeyu.lou/state/franka-stack

# LeRobot resolves this under $HF_LEROBOT_HOME. Use an owned namespace/name before any Hub upload.
FRANKA_DATASET_REPO_ID=local/franka_gello

# Leave the gs:// URI for automatic download, or set an absolute params directory.
FRANKA_BASE_CHECKPOINT=gs://openpi-assets/checkpoints/pi05_base/params
FRANKA_CONFIG=pi05_franka_jointpos
FRANKA_EXPERIMENT=franka_gello_full
